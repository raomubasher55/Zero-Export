# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
TRUST_PROXY=false
GRACEFUL_SHUTDOWN_TIMEOUT_MS=10000

# Database (required when the server starts)
MONGODB_URI=mongodb://127.0.0.1:27017/zero_export
MONGODB_DB_NAME=zero_export
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=0

# HTTP security
# Comma-separated browser origins. Do not use * in production.
CORS_ORIGINS=http://localhost:5173
REQUEST_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# Logging
LOG_LEVEL=info
LOG_FILE_ENABLED=false
LOG_DIRECTORY=logs
LOG_HEALTH_REQUESTS=false

# Defaults consumed by the Modbus connection and polling modules
MODBUS_DEFAULT_TIMEOUT_MS=3000
MODBUS_DEFAULT_RETRIES=2
MODBUS_RETRY_DELAY_MS=500
MODBUS_POOL_MAX_SIZE=100
POLLING_SCHEDULER_ENABLED=true
POLLING_CONCURRENCY=10
POLLING_TICK_INTERVAL_MS=1000
POLLING_LEASE_MS=120000

# Monitoring retention
COMMUNICATION_LOG_RETENTION_DAYS=90

# Built-in register profiles (Eastron EM500) are seeded once when their
# identifier is missing. Existing profiles are never overwritten.
SEED_BUILTIN_PROFILES=true
